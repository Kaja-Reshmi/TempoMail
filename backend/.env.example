# TempoMail backend configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local values must match docker-compose.yml defaults.
DATABASE_URL=postgresql://tempomail_user:tempomail_dev_password@localhost:5432/tempomail

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Replace with a long, unique random value. Never commit the real .env file.
JWT_SECRET=replace_with_a_long_random_secret

# SMTP provider configuration (Ethereal is suitable for development/testing).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=TempoMail <no-reply@example.com>

# BullMQ delivery and retry settings
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=5000
EMAIL_WORKER_CONCURRENCY=5
EMAIL_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_DURATION_MS=1000

# Keep false except when deliberately testing retry behavior.
SIMULATE_EMAIL_FAILURE=false
